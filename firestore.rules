rules_version = '2';
// GOB Configurator + CRM. Staff only: any signed-in Google/email account on
// gardenofficebuildings.co.uk, plus the listed personal accounts. Keep this
// list in step with EXTRA_STAFF in js/auth.js.
// Apply in Firebase console -> Firestore -> Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email.lower().matches('.*@gardenofficebuildings[.]co[.]uk')
            || request.auth.token.email.lower() in ['ljb4496@gmail.com']);
    }
    match /{document=**} {
      allow read, write: if staff();
    }
  }
}
