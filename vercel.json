{
  "functions": {
    "api/create-quote.js": {
      "maxDuration": 30
    },
    "api/mockup.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}